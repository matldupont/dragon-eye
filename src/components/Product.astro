---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { format, getTranslations, toLocale } from '../i18n/utils';

interface Props {
  /** Position in the locker, printed on the evidence tag. */
  number: number;
  title: string;
  description: string;
  price: string;
  images: ImageMetadata[];
}

const { number, title, description, price, images } = Astro.props;
const t = getTranslations(toLocale(Astro.currentLocale));
const evidenceNo = String(number).padStart(3, '0');
const altFor = (index: number) =>
  images.length > 1 ? `${title} — ${format(t.product.photoOption, { n: index + 1 })}` : title;
---

<article class="de-evidence">
  <p class="de-evidence-tag">
    <span>{t.merch.evidenceTag} {evidenceNo}</span>
    <span class="de-evidence-price">${price}</span>
  </p>

  <button type="button" class="de-evidence-photo-btn" data-open-photo aria-label={format(t.product.viewLarger, { name: title })}>
    {images.map((src, index) => (
      <Image src={src} alt="" width={600} class="de-evidence-photo" data-photo={index} hidden={index !== 0} />
    ))}
  </button>

  {images.length > 1 && (
    <div class="de-evidence-thumbs" role="group" aria-label={t.product.photoOptions}>
      {images.map((_, index) => (
        <button type="button" class="de-evidence-thumb" data-show-photo={index} aria-pressed={index === 0 ? 'true' : 'false'}>
          {format(t.product.photoOption, { n: index + 1 })}
        </button>
      ))}
    </div>
  )}

  <h2 class="de-evidence-title">{title}</h2>
  <p class="de-evidence-desc">{description}</p>

  <dialog class="de-evidence-dialog" aria-label={title}>
    <form method="dialog">
      <button class="de-dialog-close" aria-label={t.product.closePhoto}>✕</button>
    </form>
    {images.map((src, index) => (
      <Image src={src} alt={altFor(index)} width={1200} class="de-evidence-dialog-img" data-photo={index} hidden={index !== 0} />
    ))}
  </dialog>
</article>
