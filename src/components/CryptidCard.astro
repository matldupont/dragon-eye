---
import { Image } from 'astro:assets';
import Link from './Nav/Link.astro';
import DangerPill from './DangerPill.astro';
import type { LocalizedCryptid } from '../lib/cryptids';
import { format, getTranslations, toLocale } from '../i18n/utils';

interface Props {
  cryptid: LocalizedCryptid;
  /** Position in the grid, used to stagger the entrance animation. */
  index?: number;
}

const { cryptid, index = 0 } = Astro.props;
const t = getTranslations(toLocale(Astro.currentLocale));
---

<article class="de-card" style={`animation-delay: ${Math.min(index, 12) * 40}ms`}>
  <span class="de-card-casefile" aria-hidden="true">{t.card.caseFile}</span>
  <div class="de-card-img-wrap">
    <Image
      src={cryptid.image}
      alt={format(t.file.photoAlt, { name: cryptid.name })}
      width={520}
      class="de-card-img"
    />
    <span class="de-card-caseno">№ {cryptid.caseNumber}</span>
  </div>
  <div class="de-card-info">
    <h3 class="de-card-name">
      <Link to={`/files/${cryptid.id}/`} class="de-card-link">{cryptid.name}</Link>
    </h3>
    <div class="de-card-meta">
      <span>{cryptid.type}</span>
      <DangerPill level={cryptid.dangerLevel} />
    </div>
    <p class="de-card-region">{t.card.location} · {cryptid.region}</p>
  </div>
</article>
