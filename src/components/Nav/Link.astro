---
import type { HTMLAttributes } from 'astro/types';
import { localizePath, toLocale } from '../../i18n/utils';

interface Props extends HTMLAttributes<'a'> {
  to?: string;
}

const { to, href, ...attrs } = Astro.props;
const target = to ?? (typeof href === 'string' ? href : '#');
const [path, hash] = target.split('#');
// Internal links stay in the current language
const linkHref = target.startsWith('/')
  ? `${localizePath(path, toLocale(Astro.currentLocale))}${hash ? `#${hash}` : ''}`
  : target;
---

<a href={linkHref} {...attrs}><slot /></a>
