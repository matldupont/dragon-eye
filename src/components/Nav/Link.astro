---
import { localizePath, toLocale } from '../../i18n/utils';

interface Props {
  to?: string;
  href?: string;
  class?: string;
}

const { to, href, class: className } = Astro.props;
const target = to ?? href ?? '#';
// Internal links stay in the current language
const linkHref = target.startsWith('/') ? localizePath(target, toLocale(Astro.currentLocale)) : target;
---

<a href={linkHref} class={className}>
  <slot />
</a>
