---
import { Eye } from "@lucide/astro";
import Link from "./Link.astro";
import LanguageSwitcher from "../LanguageSwitcher.astro";
import { getTranslations, stripLocale, toLocale } from "../../i18n/utils";

const t = getTranslations(toLocale(Astro.currentLocale));
const path = stripLocale(Astro.url.pathname);
const currentFor = (section: string) => (path.startsWith(section) ? "page" : undefined);
---

<header class="de-nav">
  <nav class="de-wrap de-nav-inner" aria-label={t.nav.label}>
    <Link to="/" class="de-logo" aria-label={t.nav.home}>
      <Eye class="de-logo-mark" aria-hidden="true" />
      <span class="de-logo-text">Dragon Eye</span>
    </Link>

    <div class="de-nav-links">
      <Link to="/files/" aria-current={currentFor("/files")}>{t.nav.files}</Link>
      <Link to="/#about">{t.nav.about}</Link>
      <Link to="/merch/" aria-current={currentFor("/merch")}>{t.nav.merch}</Link>
      <LanguageSwitcher />
    </div>
  </nav>
</header>
