---
import { Image } from "astro:assets";
import Link from "./Nav/Link.astro";
import CryptidCard from "./CryptidCard.astro";
import DangerPill from "./DangerPill.astro";
import StatusStamp from "./StatusStamp.astro";
import { getCryptids, type LocalizedCryptid } from "../lib/cryptids";
import { format, getTranslations, toLocale } from "../i18n/utils";

interface Props {
  cryptid: LocalizedCryptid;
}

const { cryptid } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = getTranslations(locale);

// Related files: same region or type, excluding the current one
const related = (await getCryptids(locale))
  .filter((c) => c.id !== cryptid.id && (c.region === cryptid.region || c.type === cryptid.type))
  .slice(0, 4);
---

<div class="de-wrap de-dossier">
  <Link to="/files/" class="de-back">{t.file.back}</Link>

  <article class="de-dossier-sheet" aria-labelledby="dossier-name">
    <header class="de-dossier-header">
      <div>
        <p class="de-mono-label">{t.file.dossierNo}</p>
        <p class="de-dossier-no">{cryptid.caseNumber}</p>
      </div>
      <StatusStamp status={cryptid.status} />
      <div class="de-dossier-clearance">
        <p class="de-mono-label">{t.file.clearance}</p>
        <p class="de-dossier-no">{t.file.clearanceLevel}</p>
      </div>
    </header>

    <div class="de-dossier-body">
      <figure class="de-dossier-figure">
        <Image
          src={cryptid.image}
          alt={format(t.file.photoAlt, { name: cryptid.name })}
          width={800}
          class="de-dossier-photo"
          loading="eager"
        />
        <figcaption class="de-mono-label">{t.file.exhibit}</figcaption>
      </figure>

      <div>
        <h1 id="dossier-name" class="de-dossier-name">{cryptid.name}</h1>
        <DangerPill level={cryptid.dangerLevel} />

        <dl class="de-dossier-dl">
          <dt>{t.file.codename}</dt>
          <dd>{cryptid.codename}</dd>
          <dt>{t.file.type}</dt>
          <dd>{cryptid.type}</dd>
          <dt>{t.file.region}</dt>
          <dd>{cryptid.region}</dd>
          {cryptid.location && cryptid.location !== cryptid.region && (
            <>
              <dt>{t.file.location}</dt>
              <dd>{cryptid.location}</dd>
            </>
          )}
          <dt>{t.file.firstSighting}</dt>
          <dd>{cryptid.firstSighting}</dd>
          <dt>{t.file.alias}</dt>
          <dd>{cryptid.alias ?? "—"}</dd>
          <dt>{t.file.associates}</dt>
          <dd>{cryptid.knownAssociates ?? "—"}</dd>
        </dl>

        <h2 class="de-mono-label de-dossier-notes-title">{t.file.caseNotes}</h2>
        <p class="de-dossier-notes">{cryptid.description}</p>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="de-section" aria-labelledby="related-title">
      <h2 id="related-title" class="de-section-title">{t.file.relatedTitle}</h2>
      <ul class="de-files-grid de-related-grid">
        {related.map((item, index) => (
          <li>
            <CryptidCard cryptid={item} index={index} />
          </li>
        ))}
      </ul>
    </section>
  )}
</div>
