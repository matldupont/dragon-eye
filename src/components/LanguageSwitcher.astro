---
import type { Locale } from '../i18n/translations';
import { locales, localizePath, toLocale } from '../i18n/utils';

const currentLocale = toLocale(Astro.currentLocale);
const names: Record<Locale, string> = { en: 'English', fr: 'Français' };
---

<div class="de-lang">
  {locales.map((code) => (
    <a
      href={localizePath(Astro.url.pathname, code)}
      hreflang={code}
      lang={code}
      aria-label={names[code]}
      aria-current={code === currentLocale ? 'page' : undefined}
    >
      {code.toUpperCase()}
    </a>
  ))}
</div>
