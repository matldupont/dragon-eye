---
import Layout from '../layouts/Layout.astro';
import CryptidCard from '../components/CryptidCard.astro';
import { getCryptids } from '../lib/cryptids';
import { format, getTranslations, toLocale } from '../i18n/utils';

const locale = toLocale(Astro.currentLocale);
const t = getTranslations(locale);
const cryptids = await getCryptids(locale);

// Filter options, in the current language
const regions = [...new Set(cryptids.map((c) => c.region))].sort((a, b) => a.localeCompare(b, locale));
const dangerLevels = ['Low', 'Medium', 'High', 'Unknown'] as const;
const dangerLabel = (level: (typeof dangerLevels)[number]) =>
  t.dangerLevels[level.toLowerCase() as Lowercase<typeof level>];
---

<Layout title={t.files.pageTitle}>
  <section class="de-section" aria-labelledby="files-title">
    <div class="de-wrap">
      <div class="de-section-head">
        <div>
          <p class="de-eyebrow">{t.files.eyebrow}</p>
          <h1 id="files-title" class="de-section-title">{t.files.title}</h1>
        </div>
        <p class="de-section-lede">{format(t.files.lede, { count: cryptids.length })}</p>
      </div>

      <form id="files-filters" class="de-search-row" role="search">
        <label class="de-field de-field-search">
          <span class="de-sr-only">{t.files.searchLabel}</span>
          <span class="de-search-icon" aria-hidden="true">⌕</span>
          <input id="search-input" class="de-input" type="search" placeholder={t.files.searchPlaceholder} autocomplete="off" />
        </label>
        <label class="de-field">
          <span class="de-sr-only">{t.files.regionLabel}</span>
          <select id="filter-region" class="de-input">
            <option value="all">{t.files.allRegions}</option>
            {regions.map((region) => <option value={region}>{region}</option>)}
          </select>
        </label>
        <label class="de-field">
          <span class="de-sr-only">{t.files.dangerLabel}</span>
          <select id="filter-danger" class="de-input">
            <option value="all">{t.files.allLevels}</option>
            {dangerLevels.map((level) => <option value={level}>{dangerLabel(level)}</option>)}
          </select>
        </label>
      </form>

      <p id="results-count" class="de-mono-label de-results-count" aria-live="polite" data-template={t.files.resultsCount}>
        {format(t.files.resultsCount, { shown: cryptids.length, total: cryptids.length })}
      </p>

      <ul id="results-grid" class="de-files-grid">
        {cryptids.map((cryptid, index) => (
          <li
            data-search={[cryptid.name, cryptid.codename, cryptid.region, cryptid.type, cryptid.alias ?? ''].join(' ').toLowerCase()}
            data-region={cryptid.region}
            data-danger={cryptid.dangerLevel}
          >
            <CryptidCard cryptid={cryptid} index={index} />
          </li>
        ))}
      </ul>

      <div id="no-results" class="de-empty" hidden>
        <p>{t.files.noResults}</p>
        <p class="de-mono-label">{t.files.noResultsHint}</p>
      </div>
    </div>
  </section>

  <script>
    import { format } from '../i18n/format';

    const form = document.getElementById('files-filters') as HTMLFormElement;
    const search = document.getElementById('search-input') as HTMLInputElement;
    const region = document.getElementById('filter-region') as HTMLSelectElement;
    const danger = document.getElementById('filter-danger') as HTMLSelectElement;
    const count = document.getElementById('results-count') as HTMLElement;
    const empty = document.getElementById('no-results') as HTMLElement;
    const items = [...document.querySelectorAll<HTMLElement>('#results-grid > li')];
    const template = count.dataset.template ?? '{shown} / {total}';

    function applyFilters() {
      const needle = search.value.trim().toLowerCase();
      let shown = 0;

      for (const item of items) {
        const matches =
          (!needle || (item.dataset.search ?? '').includes(needle)) &&
          (region.value === 'all' || item.dataset.region === region.value) &&
          (danger.value === 'all' || item.dataset.danger === danger.value);
        item.hidden = !matches;
        if (matches) shown++;
      }

      count.textContent = format(template, { shown, total: items.length });
      empty.hidden = shown > 0;
    }

    form.addEventListener('submit', (event) => event.preventDefault());
    form.addEventListener('input', applyFilters);
  </script>
</Layout>
