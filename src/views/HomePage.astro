---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CryptidCard from '../components/CryptidCard.astro';
import Link from '../components/Nav/Link.astro';
import { getCryptids } from '../lib/cryptids';
import { format, getTranslations, toLocale } from '../i18n/utils';

const locale = toLocale(Astro.currentLocale);
const t = getTranslations(locale);
const cryptids = await getCryptids(locale);
// Newest file first — that one is the Cryptid of the Month.
const [featured, ...others] = cryptids;
const latest = others.slice(0, 8);
---

<Layout>
  <Hero featured={featured} total={cryptids.length} />

  <section class="de-section" aria-labelledby="latest-title">
    <div class="de-wrap">
      <div class="de-section-head">
        <div>
          <p class="de-eyebrow">{t.home.latestEyebrow}</p>
          <h2 id="latest-title" class="de-section-title">{t.home.latestTitle}</h2>
        </div>
        <Link to="/files/" class="de-btn">{format(t.home.browseAll, { count: cryptids.length })}</Link>
      </div>
      <ul class="de-files-grid">
        {latest.map((cryptid, index) => (
          <li>
            <CryptidCard cryptid={cryptid} index={index} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="about" class="de-section" aria-labelledby="about-title">
    <div class="de-wrap de-about-grid">
      <div>
        <p class="de-eyebrow">{t.about.eyebrow}</p>
        <h2 id="about-title" class="de-section-title">{t.about.title}</h2>
      </div>
      <div class="de-about-card">
        {t.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>
</Layout>
