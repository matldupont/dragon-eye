---
import Layout from '../layouts/Layout.astro';
import Product from '../components/Product.astro';
import { getTranslations, toLocale } from '../i18n/utils';

import shirt1 from '../assets/dragon-eye.shirt1.png';
import shirt2 from '../assets/dragon-eye.shirt2.png';
import cap from '../assets/dragon-eye.cap.png';
import kit from '../assets/dragon-eye.kit.png';
import badge from '../assets/dragon-eye.badge.png';
import bigfootStickers from '../assets/dragon-eye.big-foot-stickers.png';
import ghostStickers from '../assets/dragon-eye.ghost-stickers.png';
import lochNessStickers from '../assets/dragon-eye.loch-ness-stickers.png';
import sweatpants from '../assets/dragon-eye.pants.png';
import plushieBigFoot from '../assets/big-foot.plushie.png';
import plushieDragon from '../assets/dragon.plushie.png';
import plushieLochNess from '../assets/loch-ness.plushie.png';

const t = getTranslations(toLocale(Astro.currentLocale));

const products = [
  { category: 'agency', price: '20.00', copy: t.product.tshirt, images: [shirt1, shirt2] },
  { category: 'agency', price: '15.00', copy: t.product.cap, images: [cap] },
  { category: 'cryptid', price: '25.00', copy: t.product.detectiveKit, images: [kit] },
  { category: 'agency', price: '8.00', copy: t.product.badge, images: [badge] },
  { category: 'cryptid', price: '5.00', copy: t.product.stickerPack, images: [bigfootStickers, ghostStickers, lochNessStickers] },
  { category: 'agency', price: '30.00', copy: t.product.sweatpants, images: [sweatpants] },
  { category: 'cryptid', price: '25.00', copy: t.product.plushies, images: [plushieBigFoot, plushieDragon, plushieLochNess] },
];
---

<Layout title={t.merch.pageTitle}>
  <section class="de-section" aria-labelledby="merch-title">
    <div class="de-wrap">
      <div class="de-section-head">
        <div>
          <p class="de-eyebrow">{t.merch.eyebrow}</p>
          <h1 id="merch-title" class="de-section-title">{t.merch.title}</h1>
        </div>
        <p class="de-section-lede">{t.merch.description}</p>
      </div>

      <div class="de-tabs" role="group" aria-label={t.merch.filterLabel}>
        <button type="button" class="de-tab" data-tab="all" aria-pressed="true">{t.merch.allItems}</button>
        <button type="button" class="de-tab" data-tab="agency" aria-pressed="false">{t.merch.dragonEyeAgency}</button>
        <button type="button" class="de-tab" data-tab="cryptid" aria-pressed="false">{t.merch.cryptidCollection}</button>
      </div>

      <ul class="de-evidence-grid">
        {products.map((product, index) => (
          <li data-category={product.category}>
            <Product
              number={index + 1}
              title={product.copy.title}
              description={product.copy.description}
              price={product.price}
              images={product.images}
            />
          </li>
        ))}
      </ul>

      <aside class="de-note">
        <p class="de-note-title">{t.merch.comingSoon}</p>
        <p>{t.merch.comingSoonDescription}</p>
      </aside>
    </div>
  </section>

  <script>
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const items = [...document.querySelectorAll<HTMLElement>('[data-category]')];

    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        for (const other of tabs) other.setAttribute('aria-pressed', String(other === tab));
        for (const item of items) {
          item.hidden = tab.dataset.tab !== 'all' && item.dataset.category !== tab.dataset.tab;
        }
      });
    }

    for (const card of document.querySelectorAll<HTMLElement>('.de-evidence')) {
      const dialog = card.querySelector('dialog');
      const thumbs = [...card.querySelectorAll<HTMLButtonElement>('[data-show-photo]')];

      for (const thumb of thumbs) {
        thumb.addEventListener('click', () => {
          for (const photo of card.querySelectorAll<HTMLElement>('[data-photo]')) {
            photo.hidden = photo.dataset.photo !== thumb.dataset.showPhoto;
          }
          for (const other of thumbs) other.setAttribute('aria-pressed', String(other === thumb));
        });
      }

      card.querySelector('[data-open-photo]')?.addEventListener('click', () => dialog?.showModal());
      // Clicking the backdrop closes the photo
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    }
  </script>
</Layout>
