---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import FileDetails from '../../components/FileDetails.astro';
import { localizeCryptid, type CryptidEntry } from '../../lib/cryptids';
import { toLocale } from '../../i18n/utils';

export async function getStaticPaths() {
  const entries = await getCollection('cryptids');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CryptidEntry;
}

const cryptid = localizeCryptid(Astro.props.entry, toLocale(Astro.currentLocale));
---

<Layout title={cryptid.name} description={cryptid.description}>
  <FileDetails cryptid={cryptid} />
</Layout>
